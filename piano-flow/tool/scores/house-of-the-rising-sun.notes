# House of the Rising Sun — geleneksel, Amerikan halk şarkısı.
#
# Ezgi Frank Nordberg'in geleneksel transkripsiyonundan (abcnotation.com,
# Digital Tradition), re minörden la minöre aktarıldı — şarkının yaygın
# olarak bilindiği ton bu. Düzenleme Piano Flow: sağ el ezgi, sol el
# akorların arpeji.
#
# Akor dizisi, ölçü başına iki akor:
#     Am C | D  F | Am C | E7   |
#     Am C | D  F | Am E | Am   |

bpm: 80
beats-per-bar: 4

